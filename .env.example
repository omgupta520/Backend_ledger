# --- required ---
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/ledger   # must be a replica set (Atlas is) for transactions
JWT_SECRET=change-me-to-a-long-random-string

# where the React app is opened (used to build payment links / QR codes)
APP_URL=http://localhost:5173

# --- payment gateway (optional while learning) ---
# Leave empty -> built-in TEST gateway (fake bank screen). Never used when NODE_ENV=production.
# Get TEST keys: Razorpay Dashboard -> Test Mode -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Webhooks -> URL: https://YOUR_DOMAIN/api/topup/webhook  events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=

# handle after @ in generated UPI ids, e.g. rahul4821@ledger
UPI_HANDLE=ledger

# --- email (Gmail OAuth2, optional) ---
EMAIL_USER=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
